        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from PIL import Image\n",
        "from scipy.ndimage import binary_closing\n",
        "from google.colab import files\n",
        "\n",
        "# 1. Tải ảnh\n",
        "uploaded = files.upload()\n",
        "filename = next(iter(uploaded))\n",
        "img = cv2.imread(filename)\n",
        "\n",
        "# 2. Chọn vùng Quảng trường Lâm Viên (chỉnh tọa độ nếu cần)\n",
        "roi = img[0:400, 1000:1400]\n",
        "\n",
        "# 3. Coordinate Mapping: affine transform (xoay, nghiêng, co giãn)\n",
        "rows, cols = roi.shape[:2]\n",
        "src_pts = np.float32([[0,0], [cols-1,0], [0,rows-1]])\n",
        "dst_pts = np.float32([[0,0], [int(0.8*cols),50], [50,int(1.1*rows)]])\n",
        "M = cv2.getAffineTransform(src_pts, dst_pts)\n",
        "warped = cv2.warpAffine(roi, M, (cols, rows))\n",
        "\n",
        "# 4. Chuyển xám và nhị phân\n",
        "gray = cv2.cvtColor(warped, cv2.COLOR_BGR2GRAY)\n",
        "_, binary = cv2.threshold(gray, 100, 255, cv2.THRESH_BINARY)\n",
        "\n",
        "# 5. Binary Closing (dilation + erosion)\n",
        "binary_bool = binary > 0\n",
        "closed = binary_closing(binary_bool, structure=np.ones((5, 5)))\n",
        "closed_img = (closed * 255).astype(np.uint8)\n",
        "\n",
        "# 6. Lưu ảnh\n",
        "out_img = Image.fromarray(closed_img)\n",
        "out_img.save(\"quan_truong_lam_vien.jpg\")\n",
        "files.download(\"quan_truong_lam_vien.jpg\")\n",
        "\n",
        "# 7. Hiển thị ảnh\n",
        "plt.imshow(closed_img, cmap='gray')\n",
        "plt.title(\"Quảng Trường Lâm Viên - Coordinate Mapping + Closing\")\n",
        "plt.axis('off')\n",
        "plt.show()\n"
      ],
