        "#2.2 Phân vùng theo region\n",
        "import cv2\n",
        "from PIL import Image\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.ndimage import label\n",
        "from google.colab import files\n",
        "\n",
        "uploaded = files.upload()\n",
        "filename = next(iter(uploaded))\n",
        "data = cv2.imread(filename)\n",
        "a = cv2.cvtColor(data, cv2.COLOR_BGR2GRAY)\n",
        "_, bl = cv2.threshold(a, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)\n",
        "b2 = cv2.erode(bl, None, iterations=2)\n",
        "dist_trans = cv2.distanceTransform(b2, 2, 3)\n",
        "_, dt = cv2.threshold(dist_trans, 1, 255, cv2.THRESH_BINARY)\n",
        "dt = dt.astype(np.uint8)\n",
        "markers, _ = label(dt)\n",
        "markers = markers + 1\n",
        "markers[bl == 0] = 0\n",
        "data_ws = data.copy()\n",
        "cv2.watershed(data_ws, markers)\n",
        "output = np.zeros_like(data)\n",
        "colors = np.random.randint(0, 255, (np.max(markers)+1, 3))\n",
        "for label_id in np.unique(markers):\n",
        "    if label_id == -1 or label_id == 0:\n",
        "        continue\n",
        "    output[markers == label_id] = colors[label_id]\n",
        "plt.imshow(cv2.cvtColor(output, cv2.COLOR_BGR2RGB))\n",
        "plt.axis('off')\n",
        "plt.show()\n"
      ],
