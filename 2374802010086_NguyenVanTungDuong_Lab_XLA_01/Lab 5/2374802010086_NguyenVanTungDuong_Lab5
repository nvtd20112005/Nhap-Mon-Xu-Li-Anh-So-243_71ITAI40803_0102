        "import cv2\n",
        "import numpy as np\n",
        "from PIL import Image\n",
        "from scipy.ndimage import binary_dilation, binary_erosion\n",
        "import matplotlib.pyplot as plt\n",
        "from google.colab import files\n",
        "\n",
        "uploaded = files.upload()\n",
        "filename = next(iter(uploaded))\n",
        "img = cv2.imread(filename)\n",
        "gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n",
        "\n",
        "geo = ['coordinate_mapping', 'Rotate', 'Scale', 'Shift']\n",
        "seg = ['Adaptive_thresholding', 'Binary_dilation', 'Binary_erosion', 'Otsu']\n",
        "\n",
        "print(\"1. 1 chức năng duy nhất\\n2. Kết hợp geo + segment\")\n",
        "mode = input(\"Chọn chế độ: \")\n",
        "\n",
        "def g(x, im):\n",
        "  h, w = im.shape[:2]\n",
        "  if x == 'coordinate_mapping':\n",
        "    M = cv2.getAffineTransform(np.float32([[0,0],[w-1,0],[0,h-1]]), np.float32([[0,0],[int(0.8*w),50],[50,int(1.2*h)]]))\n",
        "    return cv2.warpAffine(im, M, (w,h))\n",
        "  if x == 'Rotate':\n",
        "    M = cv2.getRotationMatrix2D((w//2,h//2),45,1)\n",
        "    return cv2.warpAffine(im, M, (w,h))\n",
        "  if x == 'Scale': return cv2.resize(im, None, fx=1.5, fy=1.5)\n",
        "  if x == 'Shift':\n",
        "    M = np.float32([[1,0,50],[0,1,30]])\n",
        "    return cv2.warpAffine(im, M, (w,h))\n",
        "  return im\n",
        "\n",
        "def s(x, im):\n",
        "  if x == 'Adaptive_thresholding':\n",
        "    return cv2.adaptiveThreshold(im,255,cv2.ADAPTIVE_THRESH_MEAN_C,cv2.THRESH_BINARY,61,5)\n",
        "  if x == 'Binary_dilation':\n",
        "    return (binary_dilation(im>128,np.ones((5,5)))*255).astype(np.uint8)\n",
        "  if x == 'Binary_erosion':\n",
        "    return (binary_erosion(im>128,np.ones((5,5)))*255).astype(np.uint8)\n",
        "  if x == 'Otsu':\n",
        "    return cv2.threshold(im,0,255,cv2.THRESH_BINARY+cv2.THRESH_OTSU)[1]\n",
        "  return im\n",
        "\n",
        "if mode == '1':\n",
        "  all = geo + seg\n",
        "  for i, v in enumerate(all): print(f\"{i+1}. {v}\")\n",
        "  c = all[int(input(\"Chọn: \"))-1]\n",
        "  out = g(c,img) if c in geo else cv2.cvtColor(s(c,gray),cv2.COLOR_GRAY2BGR)\n",
        "else:\n",
        "  for i, v in enumerate(geo): print(f\"{i+1}. {v}\")\n",
        "  g_opt = geo[int(input(\"Geo: \"))-1]\n",
        "  for i, v in enumerate(seg): print(f\"{i+1}. {v}\")\n",
        "  s_opt = seg[int(input(\"Seg: \"))-1]\n",
        "  g_out = g(g_opt,img)\n",
        "  g_gray = cv2.cvtColor(g_out,cv2.COLOR_BGR2GRAY)\n",
        "  out = cv2.cvtColor(s(s_opt,g_gray),cv2.COLOR_GRAY2BGR)\n",
        "\n",
        "Image.fromarray(cv2.cvtColor(out,cv2.COLOR_BGR2RGB)).save(\"output_result.jpg\")\n",
        "files.download(\"output_result.jpg\")\n",
        "plt.imshow(cv2.cvtColor(out,cv2.COLOR_BGR2RGB))\n",
        "plt.axis('off')\n",
        "plt.show()\n"
